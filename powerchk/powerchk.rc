#include "resource.h"
#include <windows.h>

// Application icon (first icon resource = the EXE's Explorer icon)
IDI_POWERCHK ICON "powerchk.ico"

// Version information - personalize CompanyName / LegalCopyright as you like.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PCHK_VER_NUM
 PRODUCTVERSION PCHK_VER_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"          // US English (0x0409), Unicode code page (1200)
        BEGIN
            VALUE "CompanyName",      "powerchk"
            VALUE "FileDescription",  "powerchk - grid power LED widget for everHome EcoTracker"
            VALUE "FileVersion",      PCHK_VER_STR
            VALUE "InternalName",     "powerchk"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "powerchk.exe"
            VALUE "ProductName",      "powerchk"
            VALUE "ProductVersion",   PCHK_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
