# powerchk.credentials  —  place this file (renamed, without .example) next to powerchk.exe
#
# Cloud fallback is OPTIONAL. If this file is missing or client_id/client_secret/
# refresh_token/device_id are blank, powerchk simply runs local-only.
#
# Setup:
#   1. Create an OAuth2 application at
#        https://everhome.cloud/en/developer/applications
#      Set its redirect URL to:  http://localhost:53127/callback
#   2. Paste the Client ID / Client Secret below.
#   3. Run:  powerchk.exe --login
#      A browser opens; approve access. powerchk writes refresh_token below and
#      dumps everhome_devices.json next to the EXE — copy your EcoTracker's id
#      into device_id.
#
# Keep this file private: it contains long-lived secrets. Restrict its ACL
# (e.g. icacls powerchk.credentials /inheritance:r /grant:r "%USERNAME%:R").

client_id=
client_secret=
refresh_token=
device_id=

# --- optional overrides ---
# local_host=192.168.1.111
# cloud_interval_ms=60000          # cloud poll cadence when local is down (>=5000)
# redirect_port=53127              # must match the redirect URL registered above
# cloud_host=everhome.cloud
# cloud_device_path=/device/123    # overrides device_id if your value lives elsewhere
# sound_alert=1                   # play a sound on a green->red (export->import) edge
# alert_sound: optional custom sound. Use SINGLE backslashes and a PCM .wav
# file (PlaySound can't play mp3). A missing/invalid file falls back to the
# system sound. Paths are taken literally here -- no C/JSON escaping.
# alert_sound=C:\sounds\alert.wav
# scale=1.000                     # window zoom (0.6-4.0); also set by edge-drag resize
